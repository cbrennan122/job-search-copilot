# Copy to .env.local and fill in. .env.local is gitignored.

# Required for fit scoring (Haiku) and resume tailoring (Sonnet).
ANTHROPIC_API_KEY=

# Adzuna (free tier): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch, direct from its publisher OpenWeb Ninja (free tier: 200 req/month).
# One account-wide key, but JSearch must also be subscribed to -- an unsubscribed
# account returns 403, not 401. https://www.openwebninja.com/api/jsearch
OPENWEBNINJA_API_KEY=

# USAJobs (free): https://developer.usajobs.gov/
USAJOBS_API_KEY=
USAJOBS_EMAIL=
